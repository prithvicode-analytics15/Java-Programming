import java.util.Scanner;

class Student {
    String name;
    int[] marks;

    Student(String name, int[] marks) {
        this.name = name;
        this.marks = marks;
    }

    double calculateAverage() {
        int sum = 0;
        for (int m : marks) {
            sum += m;
        }
        return (double) sum / marks.length;
    }

    char assignGrade(double avg) {
        if (avg >= 90) {
            return 'A';
        } else if (avg >= 75) {
            return 'B';
        } else if (avg >= 60) {
            return 'C';
        } else if (avg >= 40) {
            return 'D';
        } else {
            return 'F';
        }
    }
}

public class StudentResultCardGenerator {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        while (scanner.hasNextLine()) {
            String line = scanner.nextLine().trim();
            if (line.isEmpty()) {
                continue;
            }
            int spaceIdx = line.indexOf(' ');
            String name = line.substring(0, spaceIdx);
            String marksPart = line.substring(spaceIdx + 1).trim();
            marksPart = marksPart.replace("[", "").replace("]", "");
            String[] tokens = marksPart.split(",");
            int[] marks = new int[tokens.length];
            for (int i = 0; i < tokens.length; i++) {
                marks[i] = Integer.parseInt(tokens[i].trim());
            }
            Student student = new Student(name, marks);
            double avg = student.calculateAverage();
            char grade = student.assignGrade(avg);
            System.out.printf("%s: Average %.1f, Grade %c\n", student.name.toUpperCase(), avg, grade);
        }
        scanner.close();
    }
}
