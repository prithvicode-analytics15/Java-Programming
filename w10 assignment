public class DigitSumAndReverse {
    public static void main(String[] args) {
        int number = 4721;
        int sum = 0;
        int reverse = 0;
        int temp = number;

        while (temp > 0) {
            int digit = temp % 10;
            sum += digit;
            reverse = reverse * 10 + digit;
            temp /= 10;
        }

        System.out.println("Sum of digits: " + sum);
        System.out.println("Reverse: " + reverse);
    }
}
