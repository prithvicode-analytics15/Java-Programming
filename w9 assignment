import java.util.Scanner;
import java.util.ArrayList;
import java.util.List;

interface SaverModeable {
    double applySaver(double units);
}

abstract class Appliance {
    protected String name;
    protected double hours;
    protected boolean isSaver;
    protected double powerWatts;

    public Appliance(String name, double hours, boolean isSaver, double powerWatts) {
        this.name = name;
        this.hours = hours;
        this.isSaver = isSaver;
        this.powerWatts = powerWatts;
    }

    public String getName() {
        return name;
    }

    public boolean isSaver() {
        return isSaver;
    }

    public double calculateUnits() {
        double units = (powerWatts * hours) / 1000.0;
        if (isSaver && this instanceof SaverModeable) {
            units = ((SaverModeable) this).applySaver(units);
        }
        return units;
    }
}

class Fridge extends Appliance {
    public Fridge(String name, double hours, boolean isSaver) {
        super(name, hours, isSaver, 150.0);
    }
}

class AirConditioner extends Appliance implements SaverModeable {
    public AirConditioner(String name, double hours, boolean isSaver) {
        super(name, hours, isSaver, 1500.0);
    }

    @Override
    public double applySaver(double units) {
        return units * 0.75;
    }
}

class TV extends Appliance {
    public TV(String name, double hours, boolean isSaver) {
        super(name, hours, isSaver, 100.0);
    }
}

class Washer extends Appliance implements SaverModeable {
    public Washer(String name, double hours, boolean isSaver) {
        super(name, hours, isSaver, 500.0);
    }

    @Override
    public double applySaver(double units) {
        return units * 0.75;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) {
            scanner.close();
            return;
        }
        int n = scanner.nextInt();
        scanner.nextLine();
        List<Appliance> list = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            String line = scanner.nextLine().trim();
            if (line.isEmpty()) {
                i--;
                continue;
            }
            String[] parts = line.split("\\s+");
            String type = parts[0];
            double hours = Double.parseDouble(parts[1]);
            boolean isSaver = parts.length > 2 && parts[2].equals("SAVER");

            if (type.equals("FRIDGE")) {
                list.add(new Fridge(type, hours, isSaver));
            } else if (type.equals("AC")) {
                list.add(new AirConditioner(type, hours, isSaver));
            } else if (type.equals("TV")) {
                list.add(new TV(type, hours, isSaver));
            } else if (type.equals("WASHER")) {
                list.add(new Washer(type, hours, isSaver));
            }
        }
        scanner.close();

        double totalCost = 0;
        for (Appliance app : list) {
            if (app.isSaver() && !(app instanceof SaverModeable)) {
                System.out.println(app.getName() + ": saver mode not supported");[cite: 9]
            } else {
                double units = app.calculateUnits();
                double cost = units * 8.0;[cite: 9]
                totalCost += cost;
                System.out.printf("%s: Units=%.2f Cost=%.2f%n", app.getName(), units, cost);[cite: 9]
            }
        }
        System.out.printf("Total Cost: %.2f%n", totalCost);[cite: 9]
    }
}
