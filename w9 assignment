import java.util.Scanner;
import java.util.ArrayList;
import java.util.List;

interface BusUser {
    double TRANSPORT_FEE = 12000.0;
}

abstract class Student {
    protected String name;
    protected String type;

    public Student(String type, String name) {
        this.type = type;
        this.name = name;
    }

    public String getName() {
        return name;
    }

    public abstract double calculateTuition();

    public double calculateTotalFee() {
        double total = calculateTuition();
        if (this instanceof BusUser) {
            total += BusUser.TRANSPORT_FEE;
        }
        return total;
    }
}

class DayScholar extends Student implements BusUser {
    public DayScholar(String type, String name) {
        super(type, name);
    }

    @Override
    public double calculateTuition() {
        return 40000.0;
    }
}

class Hosteller extends Student {
    public Hosteller(String type, String name) {
        super(type, name);
    }

    @Override
    public double calculateTuition() {
        return 40000.0 + 60000.0;
    }
}

class Scholar extends Student implements BusUser {
    public Scholar(String type, String name) {
        super(type, name);
    }

    @Override
    public double calculateTuition() {
        return 20000.0;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) {
            scanner.close();
            return;
        }
        int n = scanner.nextInt();
        List<Student> students = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            String type = scanner.next();
            String name = scanner.next();

            if (type.equals("DAY_SCHOLAR")) {
                students.add(new DayScholar(type, name));
            } else if (type.equals("HOSTELLER")) {
                students.add(new Hosteller(type, name));
            } else if (type.equals("SCHOLAR") || type.equals("SCHDLAR")) {
                students.add(new Scholar(type, name));
            }
        }
        scanner.close();

        double totalCollected = 0;
        for (Student student : students) {
            double fee = student.calculateTotalFee();
            totalCollected += fee;
            System.out.printf("%s: %.2f%n", student.getName(), fee);
        }
        System.out.printf("Total Collected: %.2f%n", totalCollected);
    }
}
