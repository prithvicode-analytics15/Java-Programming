import java.util.*;
abstract class Plot {
    protected String owner;
    Plot(String owner) {
        this.owner = owner;
    }
 abstract double area();
abstract String shape();
String report() {
        return String.format("%s (%s): %.2f", owner, shape(), area());
    }
}
class Circle extends Plot {
    private double radius;

    Circle(String owner, double radius) {
        super(owner);
        this.radius = radius;
    }

    double area() {
        return Math.PI * radius * radius;
    }
    String shape() {
        return "CIRCLE";
    }
}
class Rectangle extends Plot {
    private double length, width;
    Rectangle(String owner, double length, double width) {
        super(owner);
        this.length = length;
        this.width = width;
    }
    double area() {
        return length * width;
    }
    String shape() {
        return "RECTANGLE";
}
}
class Triangle extends Plot {
private double base, height;
Triangle(String owner, double base, double height) {
        super(owner);
        this.base = base;
        this.height = height;
    }

    double area() {
        return 0.5 * base * height;
    }

    String shape() {
        return "TRIANGLE";
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = Integer.parseInt(sc.nextLine().trim());
        List<Plot> plots = new ArrayList<>();
    for (int i = 0; i < n; i++) {
            String[] p = sc.nextLine().trim().split("\\s+");
            String type = p[0].toUpperCase();
            String owner = p[1];
            switch (type) {
                case "CIRCLE":
                    plots.add(new Circle(owner, Double.parseDouble(p[2])));
                    break;
                case "RECTANGLE":
                    plots.add(new Rectangle(owner, Double.parseDouble(p[2]), Double.parseDouble(p[3])));
                    break;
                case "TRIANGLE":
                    plots.add(new Triangle(owner, Double.parseDouble(p[2]), Double.parseDouble(p[3])));
                    break;
            }
        }
        double total = 0;
        for (Plot plot : plots) {
            System.out.println(plot.report());
            total += plot.area();
        }
        System.out.println(String.format("Total Area: %.2f", total));
    }
}
